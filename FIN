    final result = await showModalBottomSheet<Map<String, dynamic>>(
      context: context, backgroundColor: Colors.transparent, isScrollControlled: true, 
      builder: (context) { return const AddTransactionSheet(); }
    );
    
    if (result != null && result['amount'] > 0) {
      _fastExecute(context, 
        () {
          var acc = myAccounts.firstWhere((a) => a.id == result['accountId']);
          if (result['type'] == 'expense' || result['type'] == 'asset') acc.balance -= result['amount'] as int;
          else if (result['type'] == 'income') acc.balance += result['amount'] as int;
        }, 
        () async {
          await Supabase.instance.client.from('transactions').insert({
            'user_id': myDeviceId, 
            'title': result['title'], 
            'note': result['note'], 
            'amount': result['amount'], 
            'type': result['type'], 
            'category': result['category']
          });
        }
      );
    }
  }

