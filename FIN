    Widget bgLayer = currentBg == 'white_solid' ? Container(color: Colors.white) : (currentBg == 'black_solid' ? Container(color: Colors.black) : (currentBg != null ? Stack(fit: StackFit.expand, children: [Image.network(currentBg!, fit: BoxFit.cover, errorBuilder: (c, e, s) => Container(color: const Color(0xFF0F0F13))), Container(color: Colors.black.withOpacity(globalIsBgBlurred ? 0.0 : 0.4))]) : Container(color: const Color(0xFF0F0F13))));

