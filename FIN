  @override 
  Widget build(BuildContext context) {
    List<Transaction> analyticsExpenses = widget.transactions.where((t) => t.type == 'expense').toList(); 
    List<Transaction> analyticsIncomes = widget.transactions.where((t) => t.type == 'income').toList();
    
    int cashIn = 0; int cashOut = 0; 
    List<Transaction> inList = []; List<Transaction> outList = [];

    if (turnoverMode == 0 || turnoverMode == 2) { 
      final inc = widget.transactions.where((t) => t.type == 'income').toList(); 
      final exp = widget.transactions.where((t) => t.type == 'expense').toList(); 
      cashIn += inc.fold(0, (s,t) => s+t.amount); cashOut += exp.fold(0, (s,t) => s+t.amount); 
      inList.addAll(inc); outList.addAll(exp); 
    }
    
    if (turnoverMode == 1 || turnoverMode == 2) { 
      final aSale = widget.transactions.where((t) => t.type == 'asset_sale').toList(); 
      final aBuy = widget.transactions.where((t) => t.type == 'asset' || t.type == 'sold_asset').toList(); 
      cashIn += aSale.fold(0, (s,t) => s+t.amount); cashOut += aBuy.fold(0, (s,t) => s+t.amount); 
      inList.addAll(aSale); outList.addAll(aBuy); 
    }
    
    inList.sort((a,b) => b.date.compareTo(a.date)); 
    outList.sort((a,b) => b.date.compareTo(a.date));
    
    final investCat = appCategories.firstWhere((c) => c.name == 'Инвестиции', orElse: () => CategoryItem('Инвестиции', Icons.trending_up, Colors.amber));
    
    for (var saleTx in widget.transactions.where((t) => t.type == 'asset_sale')) { 
      String baseName = saleTx.title.replaceFirst('Продажа: ', ''); 
      var buyTxList = widget.allTransactions.where((t) => (t.type == 'sold_asset' || t.type == 'asset' || t.type == 'asset_owned') && t.title == baseName); 
      if (buyTxList.isNotEmpty) { 
        int buyPrice = buyTxList.first.amount; int delta = saleTx.amount - buyPrice; 
        if (delta < 0) analyticsExpenses.add(Transaction(id: 'margin_${saleTx.id}', title: 'Убыток: $baseName', note: '', amount: delta.abs(), type: 'margin_loss', category: 'Инвестиции', icon: Icons.trending_down, iconColor: investCat.color, date: saleTx.date)); 
        else if (delta > 0) analyticsIncomes.add(Transaction(id: 'margin_${saleTx.id}', title: 'Прибыль: $baseName', note: '', amount: delta, type: 'margin_profit', category: 'Инвестиции', icon: Icons.trending_up, iconColor: investCat.color, date: saleTx.date)); 
      } 
    }

    int totalExpense = 0; Map<String, int> expTotals = {}; 
    for (var tx in analyticsExpenses) { totalExpense += tx.amount; expTotals[tx.category] = (expTotals[tx.category] ?? 0) + tx.amount; }
    var sortedExps = expTotals.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
    
    int totalIncome = 0; Map<String, int> incTotals = {}; 
    for (var tx in analyticsIncomes) { totalIncome += tx.amount; incTotals[tx.category] = (incTotals[tx.category] ?? 0) + tx.amount; }
    var sortedIncs = incTotals.entries.toList()..sort((a, b) => b.value.compareTo(a.value));
    
    int netProfit = totalIncome - totalExpense; 
    var currentSorted = showIncomeAnalysis ? sortedIncs : sortedExps; 
    int currentTotal = showIncomeAnalysis ? totalIncome : totalExpense;
    
    List<PieChartSectionData> chartSections = [];
    if (currentSorted.isEmpty) { 
      chartSections.add(PieChartSectionData(color: gBg, value: 1, title: '', radius: 30)); 
    } else { 
      for (int i = 0; i < currentSorted.length; i++) { 
        var entry = currentSorted[i]; final isTouched = i == touchedIndex; final double radius = isTouched ? 45.0 : 35.0; double percent = (entry.value / currentTotal) * 100; 
        final catObj = appCategories.firstWhere((c) => c.name == entry.key, orElse: () => CategoryItem(entry.key, Icons.inventory_2_outlined, Colors.grey.shade600)); 
        Color sectionColor = entry.key == 'Инвестиции' ? investCat.color : catObj.color; 
        chartSections.add(PieChartSectionData(color: sectionColor, value: entry.value.toDouble(), title: percent > 5 && !isTouched ? '${percent.toStringAsFixed(0)}%' : '', radius: radius, titleStyle: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: Colors.white))); 
      } 
    }
    
    String? selectedCatName = touchedIndex != -1 && currentSorted.isNotEmpty ? currentSorted[touchedIndex].key : null;
    List<Transaction> drillDownTx = selectedCatName != null ? (showIncomeAnalysis ? analyticsIncomes : analyticsExpenses).where((t) => t.category == selectedCatName).toList() : [];

    return SafeArea(
      bottom: false, 
      child: SingleChildScrollView(
        padding: const EdgeInsets.only(left: 20.0, right: 20.0, top: 20.0, bottom: 180.0), 
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start, 
          children: [
            Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [Expanded(child: Text(t('Аналитика', 'Analytics'), style: TextStyle(color: pText, fontSize: 32, fontWeight: FontWeight.bold, letterSpacing: -1))), DateRangePickerButton(selectedDateRange: widget.selectedDateRange, onRangeChanged: widget.onDateRangeChanged)]), 
            const SizedBox(height: 24),
            
            Row(children: [Expanded(child: Text(t('Оборот (Cash Flow)', 'Cash Flow'), style: TextStyle(color: pText, fontSize: 20, fontWeight: FontWeight.bold))), GestureDetector(onTap: () => _showInfoPopup(context, t("Оборот (Cash Flow)", "Cash Flow"), t("Оборот — это все фактические поступления и списания денег.\n\nЕсли вы купили машину за 100к, оборот покажет расход 100к. Если продали за 120к — поступление 120к.", "Cash flow is all actual receipts and debits. If you buy a car for 100k, it shows as 100k expense.")), child: Icon(Icons.info_outline, color: sText, size: 20))]), 
