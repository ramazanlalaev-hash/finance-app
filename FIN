                              Expanded(child: Text(d.title, style: TextStyle(color: pText, fontSize: 18, fontWeight: FontWeight.bold), maxLines: 1, overflow: TextOverflow.ellipsis)), 
                              const SizedBox(width: 16), 
                              Text('${(pct*100).toInt()}%', style: TextStyle(color: barColor, fontWeight: FontWeight.bold))
                            ]
                          ), 
                          const SizedBox(height: 12), 
                          Stack(children: [Container(height: 8, width: double.infinity, decoration: BoxDecoration(color: globalIsLightMode ? Colors.black12 : Colors.white.withOpacity(0.1), borderRadius: BorderRadius.circular(4))), LayoutBuilder(builder: (context, constraints) => AnimatedContainer(duration: const Duration(milliseconds: 300), height: 8, width: constraints.maxWidth * pct, decoration: BoxDecoration(color: barColor, borderRadius: BorderRadius.circular(4), boxShadow: [BoxShadow(color: barColor.withOpacity(0.5), blurRadius: 8)])))]), 
                          const SizedBox(height: 12), 
                          Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [Text('${t("Оплачено", "Paid")}: ${formatMoney(d.paidAmount)} / ${formatMoney(d.totalAmount)}', style: TextStyle(color: sText, fontSize: 12)), Text('${t("Дата возврата", "Due Date")}: ${formatCustomDate(d.dueDate)}', style: TextStyle(color: sText, fontSize: 12))])
                        ]
                      )
                    )
                  ); 
                }
              )
        )
      ]
    );
  }
}

