Future<void> saveCategoriesToPrefs() async { 
  final prefs = await SharedPreferences.getInstance(); 
  await prefs.setStringList('saved_categories', appCategories.map((c) => '${c.name}|${c.icon.codePoint}|${c.color.value}|${c.scope}').toList()); 
}

Future<void> loadCategoriesFromPrefs() async { 
  final prefs = await SharedPreferences.getInstance(); 
  List<String>? encoded = prefs.getStringList('saved_categories'); 
  if (encoded != null && encoded.isNotEmpty) {
    appCategories = encoded.map((s) { 
      final parts = s.split('|'); 
      return CategoryItem(parts[0], IconData(int.parse(parts[1]), fontFamily: 'MaterialIcons'), Color(int.parse(parts[2])), scope: parts.length > 3 ? parts[3] : 'both'); 
    }).toList(); 
  }
}

Future<void> saveLocalData() async { 
