class CategoryItem { 
  String name; IconData icon; Color color; String scope; 
  CategoryItem(this.name, this.icon, this.color, {this.scope = 'both'}); 
}

class BankAccount { 
  String id; String name; int balance; Color color; IconData icon; 
  BankAccount({required this.id, required this.name, required this.balance, required this.color, required this.icon}); 
  Map<String, dynamic> toJson() => {'id': id, 'name': name, 'balance': balance, 'color': color.value, 'icon': icon.codePoint}; 
  factory BankAccount.fromJson(Map<String, dynamic> j) => BankAccount(id: j['id'], name: j['name'], balance: j['balance'], color: Color(j['color']), icon: IconData(j['icon'], fontFamily: 'MaterialIcons')); 
}

class BigGoal { 
  String id; String name; int targetAmount; int savedAmount; Color color; IconData icon; 
  BigGoal({required this.id, required this.name, required this.targetAmount, required this.savedAmount, required this.color, required this.icon}); 
  Map<String, dynamic> toJson() => {'id': id, 'name': name, 'targetAmount': targetAmount, 'savedAmount': savedAmount, 'color': color.value, 'icon': icon.codePoint}; 
  factory BigGoal.fromJson(Map<String, dynamic> j) => BigGoal(id: j['id'], name: j['name'], targetAmount: j['targetAmount'], savedAmount: j['savedAmount'], color: Color(j['color']), icon: IconData(j['icon'], fontFamily: 'MaterialIcons')); 
}

class RecurringTx { 
  String id; String title; int amount; String type; String category; String accountId; int dayOfMonth; 
  RecurringTx({required this.id, required this.title, required this.amount, required this.type, required this.category, required this.accountId, required this.dayOfMonth}); 
  Map<String, dynamic> toJson() => {'id': id, 'title': title, 'amount': amount, 'type': type, 'category': category, 'accountId': accountId, 'dayOfMonth': dayOfMonth}; 
  factory RecurringTx.fromJson(Map<String, dynamic> j) => RecurringTx(id: j['id'], title: j['title'], amount: j['amount'], type: j['type'], category: j['category'], accountId: j['accountId'], dayOfMonth: j['dayOfMonth']); 
}

class Debt { 
  String id; String title; int totalAmount; int paidAmount; String type; DateTime dueDate; 
  List<Map<String, dynamic>> history; 
  Debt({required this.id, required this.title, required this.totalAmount, required this.paidAmount, required this.type, required this.dueDate, this.history = const []}); 
  Map<String, dynamic> toJson() => {'id': id, 'title': title, 'totalAmount': totalAmount, 'paidAmount': paidAmount, 'type': type, 'dueDate': dueDate.toIso8601String(), 'history': history}; 
  factory Debt.fromJson(Map<String, dynamic> j) => Debt(id: j['id'], title: j['title'], totalAmount: j['totalAmount'], paidAmount: j['paidAmount'], type: j['type'], dueDate: DateTime.parse(j['dueDate']), history: j['history'] != null ? List<Map<String, dynamic>>.from(j['history']) : []); 
}

class Transaction { 
  final dynamic id; final String title, note, type, category; final int amount; final IconData icon; final Color iconColor; final DateTime date; 
  Transaction({required this.id, required this.title, required this.note, required this.amount, required this.type, required this.category, required this.icon, required this.iconColor, required this.date}); 
  Map<String, dynamic> toJson() => {'id': id, 'title': title, 'note': note, 'type': type, 'category': category, 'amount': amount, 'icon': icon.codePoint, 'iconColor': iconColor.value, 'date': date.toIso8601String()}; 
  factory Transaction.fromJson(Map<String, dynamic> json) => Transaction(id: json['id'], title: json['title'], note: json['note'], type: json['type'], category: json['category'], amount: json['amount'], icon: IconData(json['icon'], fontFamily: 'MaterialIcons'), iconColor: Color(json['iconColor']), date: DateTime.parse(json['date'])); 
}

