  int _currentIndex = 0, totalBalance = 0, streakCount = 1; 
  List<Transaction> allTransactions = []; 
  bool isLoading = true, isLocked = false; 
  String? currentBg; String userLevel = "🐣 Новичок";
  DateTimeRange selectedDateRange = DateTimeRange(start: DateTime(DateTime.now().year, DateTime.now().month, 1), end: DateTime(DateTime.now().year, DateTime.now().month + 1, 0));
  
  final LocalAuthentication auth = LocalAuthentication(); String? savedPin; bool useBiometrics = false; String enteredPin = "";

  @override 
  void initState() { 
    super.initState(); 
    _initApp(); 
  }

  Future<void> _initApp() async {
    final prefs = await SharedPreferences.getInstance(); 
    isProUser = prefs.getBool('is_pro_user') ?? false; 
    
    // БЕЗОПАСНОСТЬ APPLE: Читаем пин-код из Keychain
    savedPin = await secureStorage.read(key: 'app_pin'); 
    useBiometrics = prefs.getBool('use_biometrics') ?? false;
    
    if (savedPin != null && isProUser) { 
      setState(() => isLocked = true); 
      if (useBiometrics) { 
        Future.delayed(const Duration(milliseconds: 500), () { if (mounted) _authenticateBiometrics(); }); 
      } 
    }
    await loadCategoriesFromPrefs(); 
    await loadLocalData(); 
    await _loadSettings(); 
    await _updateStreak(); 
    await _loadCachedTransactions(); 
    _fetchTransactions();
  }

  Future<void> _loadCachedTransactions() async {
    final prefs = await SharedPreferences.getInstance(); 
    final String? cachedData = prefs.getString('cached_tx');
    if (cachedData != null) {
      Iterable decoded = jsonDecode(cachedData); 
      List<Transaction> cachedTx = List<Transaction>.from(decoded.map((model) => Transaction.fromJson(model)));
      int calcBal = myAccounts.fold(0, (sum, acc) => sum + acc.balance);
      if (mounted) setState(() { allTransactions = cachedTx; totalBalance = calcBal; isLoading = false; });
    }
  }

  Future<void> _authenticateBiometrics() async { 
    try { 
      bool authenticated = await auth.authenticate(localizedReason: t('Разблокируйте FlowIQ', 'Unlock FlowIQ')); 
      if (authenticated) setState(() => isLocked = false); 
    } catch (e) { print(e); } 
  }
  
  void _onPinKeyPress(String digit) { 
    if (digit == "<") { 
      if (enteredPin.isNotEmpty) setState(() => enteredPin = enteredPin.substring(0, enteredPin.length - 1)); 
    } else { 
      if (enteredPin.length < 4) setState(() => enteredPin += digit); 
      if (enteredPin.length == 4) { 
        if (enteredPin == savedPin) { 
          setState(() { isLocked = false; enteredPin = ""; }); 
        } else { 
          HapticFeedback.heavyImpact(); setState(() => enteredPin = ""); 
        } 
      } 
    } 
  }
  
  void _forceRebuild() { setState(() {}); _fetchTransactions(); }

  Future<void> _updateStreak() async {
    final prefs = await SharedPreferences.getInstance(); 
    final String? lastDateStr = prefs.getString('last_login_date'); 
    final DateTime today = DateTime(DateTime.now().year, DateTime.now().month, DateTime.now().day);
    if (lastDateStr != null) { 
      final diff = today.difference(DateTime.parse(lastDateStr)).inDays; 
      streakCount = (diff == 1) ? (prefs.getInt('streak_count') ?? 1) + 1 : (diff == 0 ? (prefs.getInt('streak_count') ?? 1) : 1); 
    } 
    await prefs.setString('last_login_date', today.toIso8601String()); 
    await prefs.setInt('streak_count', streakCount); 
    userLevel = streakCount < 3 ? "🐣 ${t("Новичок", "Beginner")}" : (streakCount < 7 ? "🛡️ ${t("Контролёр", "Controller")}" : "👑 ${t("Инвестор", "Investor")}"); 
    if (mounted) setState(() {});
  }

  Future<void> _loadSettings() async { 
    final prefs = await SharedPreferences.getInstance(); 
    final url = prefs.getString('wallpaper'); 
    globalIsBgBlurred = prefs.getBool('bg_blur') ?? false; 
    setState(() { 
      currentBg = url; globalIsLightMode = url == 'white_solid'; 
      appAccentColor = url != null ? (wallpaperAccents[url] ?? const Color(0xFF00FFA3)) : const Color(0xFF00FFA3); 
    }); 
    SystemChrome.setSystemUIOverlayStyle(SystemUiOverlayStyle(statusBarColor: Colors.transparent, statusBarIconBrightness: globalIsLightMode ? Brightness.dark : Brightness.light, systemNavigationBarIconBrightness: globalIsLightMode ? Brightness.dark : Brightness.light)); 
  }
  
  Future<void> _changeWallpaper(String? url) async { 
    final prefs = await SharedPreferences.getInstance(); 
    if (url == null) { prefs.remove('wallpaper'); } else { prefs.setString('wallpaper', url); } 
    await _loadSettings(); 
  }

  Future<void> _fetchTransactions() async {
    try {
      final data = await Supabase.instance.client.from('transactions').select().eq('user_id', myDeviceId).order('created_at', ascending: false);
      List<Transaction> fetchedTx = []; 
      for (var row in data) {
        final type = row['type'] as String? ?? 'expense'; 
        final amount = (row['amount'] as num).toInt(); 
        final catName = row['category'] as String? ?? 'Разное';
        final catObj = appCategories.firstWhere((c) => c.name == catName, orElse: () => CategoryItem(catName, Icons.category, Colors.grey));
        
        IconData txIcon = catObj.icon; Color txColor = catObj.color;
        if (type == 'income' || type == 'asset_sale') { txIcon = Icons.arrow_downward; txColor = globalIsLightMode ? Colors.blueAccent : Colors.blue; }
        if (type == 'asset' || type == 'asset_owned' || type == 'sold_asset') { txIcon = Icons.diamond_outlined; txColor = globalIsLightMode ? Colors.orange : Colors.amber; }
        if (type == 'transfer') { txIcon = Icons.swap_horiz; txColor = Colors.purpleAccent; }
        
        fetchedTx.add(Transaction(id: row['id'], title: row['title'], note: row['note'] ?? '', amount: amount, type: type, category: catName, icon: txIcon, iconColor: txColor, date: row['created_at'] != null ? DateTime.parse(row['created_at']) : DateTime.now()));
      }
      final prefs = await SharedPreferences.getInstance(); 
      await prefs.setString('cached_tx', jsonEncode(fetchedTx.map((t) => t.toJson()).toList()));
      if (mounted) setState(() { allTransactions = fetchedTx; totalBalance = myAccounts.fold(0, (sum, acc) => sum + acc.balance); isLoading = false; });
    } catch (e) { 
      if (mounted) setState(() => isLoading = false); 
    }
  }

