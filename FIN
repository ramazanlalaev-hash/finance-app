    setState(() { 
      if (value == "C") amount = "0"; 
      else if (value == "<") amount = amount.length > 1 ? amount.substring(0, amount.length - 1) : "0"; 
      else if (amount == "0") amount = value; 
      else if (amount.length < 8) amount += value; 
    }); 
  }
  
