                      SizedBox(width: double.infinity, height: 56, child: ElevatedButton(style: ElevatedButton.styleFrom(backgroundColor: appAccentColor, foregroundColor: accentTextColor, elevation: 0, shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16))), onPressed: () { if(nameC.text.isNotEmpty && amtC.text.isNotEmpty) { setState(() { myDebts.add(Debt(id: DateTime.now().millisecondsSinceEpoch.toString(), title: nameC.text, totalAmount: int.parse(amtC.text), paidAmount: 0, type: selectedType, dueDate: selectedDate)); }); saveLocalData(); Navigator.pop(c); } }, child: Text(t("Сохранить", "Save"), style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold)))), 
                      const SizedBox(height: 10)
                    ]
                  )
                )
              )
            )
          )
        )
      )
    );
  }

  void _payDebt(Debt debt, VoidCallback onPaidSuccess) {
    TextEditingController amtC = TextEditingController();
    showModalBottomSheet(
      context: context, backgroundColor: Colors.transparent, isScrollControlled: true, 
      builder: (c) => Padding(
        padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom),
        child: ClipRRect(
          borderRadius: const BorderRadius.vertical(top: Radius.circular(30)), 
          child: BackdropFilter(
            filter: ImageFilter.blur(sigmaX: 30, sigmaY: 30), 
            child: Container(
              padding: const EdgeInsets.only(left: 24, right: 24, top: 24, bottom: 24), decoration: BoxDecoration(color: sBg), 
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min, 
                  children: [
                    Container(width: 40, height: 4, decoration: BoxDecoration(color: gBorder, borderRadius: BorderRadius.circular(2))), 
                    const SizedBox(height: 30), Text(t("Погасить долг", "Pay off debt"), style: TextStyle(color: pText, fontSize: 24, fontWeight: FontWeight.bold)), 
                    const SizedBox(height: 8), Text('${debt.title} (${t("Осталось", "Left")}: ${formatMoney(debt.totalAmount - debt.paidAmount)} $appCurrency)', style: TextStyle(color: sText, fontSize: 16)), 
                    const SizedBox(height: 24), 
                    Container(padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8), decoration: BoxDecoration(color: globalIsLightMode ? Colors.black.withOpacity(0.05) : Colors.white.withOpacity(0.05), borderRadius: BorderRadius.circular(16), border: Border.all(color: appAccentColor.withOpacity(0.5))), child: TextField(controller: amtC, keyboardType: TextInputType.number, autofocus: true, style: TextStyle(color: appAccentColor, fontSize: 32, fontWeight: FontWeight.bold), decoration: InputDecoration(border: InputBorder.none, hintText: "0 $appCurrency", hintStyle: TextStyle(color: sText)))), 
                    const SizedBox(height: 24), 
                    SizedBox(
                      width: double.infinity, height: 56, 
                      child: ElevatedButton(
                        style: ElevatedButton.styleFrom(backgroundColor: appAccentColor, foregroundColor: accentTextColor, elevation: 0, shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16))), 
                        onPressed: () { 
                          int val = int.tryParse(amtC.text) ?? 0; 
                          if (val > 0) { 
                            setState(() { 
                              debt.paidAmount += val; 
                              if (debt.paidAmount > debt.totalAmount) debt.paidAmount = debt.totalAmount; 
                              debt.history.insert(0, {'date': DateTime.now().toIso8601String(), 'amount': val});
                            }); 
                            saveLocalData(); 
                            onPaidSuccess();
                            Navigator.pop(c); 
                          } 
                        }, 
                        child: Text(t("Сохранить", "Save"), style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold))
                      )
                    ), 
                    const SizedBox(height: 10)
                  ]
                )
              )
            )
          )
        )
      )
    );
  }

  void _showDebtDetails(Debt debt) {
    showModalBottomSheet(
      context: context, 
      backgroundColor: Colors.transparent, 
      isScrollControlled: true,
      builder: (c) {
        return StatefulBuilder(
          builder: (context, setModalState) {
            double pct = debt.paidAmount / debt.totalAmount; 
            if(pct > 1) pct = 1;
            Color barColor = debt.type == 'i_owe' ? Colors.redAccent : Colors.green;
            
            return ClipRRect(
              borderRadius: const BorderRadius.vertical(top: Radius.circular(30)),
              child: BackdropFilter(
                filter: ImageFilter.blur(sigmaX: 30, sigmaY: 30),
                child: Container(
                  height: MediaQuery.of(context).size.height * 0.85,
                  padding: const EdgeInsets.all(24),
                  decoration: BoxDecoration(color: sBg),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Center(child: Container(width: 40, height: 4, decoration: BoxDecoration(color: gBorder, borderRadius: BorderRadius.circular(2)))),
                      const SizedBox(height: 24),
                      Text(debt.title, style: TextStyle(color: pText, fontSize: 28, fontWeight: FontWeight.bold), maxLines: 2, overflow: TextOverflow.ellipsis),
                      const SizedBox(height: 8),
                      Text('${t("Осталось", "Left")}: ${formatMoney(debt.totalAmount - debt.paidAmount)} $appCurrency', style: TextStyle(color: sText, fontSize: 16)),
                      const SizedBox(height: 24),
                      
                      Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [Text('${t("Оплачено", "Paid")}: ${formatMoney(debt.paidAmount)} / ${formatMoney(debt.totalAmount)}', style: TextStyle(color: sText, fontSize: 14)), Text('${(pct*100).toInt()}%', style: TextStyle(color: barColor, fontWeight: FontWeight.bold))]), 
                      const SizedBox(height: 12), 
                      Stack(children: [Container(height: 12, width: double.infinity, decoration: BoxDecoration(color: globalIsLightMode ? Colors.black12 : Colors.white.withOpacity(0.1), borderRadius: BorderRadius.circular(6))), LayoutBuilder(builder: (context, constraints) => AnimatedContainer(duration: const Duration(milliseconds: 300), height: 12, width: constraints.maxWidth * pct, decoration: BoxDecoration(color: barColor, borderRadius: BorderRadius.circular(6), boxShadow: [BoxShadow(color: barColor.withOpacity(0.5), blurRadius: 8)])))]), 
                      const SizedBox(height: 24),

                      if (debt.paidAmount < debt.totalAmount)
                        SizedBox(
                          width: double.infinity, height: 56, 
                          child: ElevatedButton(
                            style: ElevatedButton.styleFrom(backgroundColor: barColor.withOpacity(0.2), elevation: 0, shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16))),
                            onPressed: () {
                              _payDebt(debt, () { setModalState((){}); setState((){}); });
                            },
                            child: Text(t("Внести платеж", "Make Payment"), style: TextStyle(color: barColor, fontSize: 16, fontWeight: FontWeight.bold))
                          )
                        ),
                      const SizedBox(height: 32),
                      
                      Text(t("История платежей", "Payment History"), style: TextStyle(color: pText, fontSize: 20, fontWeight: FontWeight.bold)),
                      const SizedBox(height: 16),
                      
                      Expanded(
                        child: debt.history.isEmpty 
                          ? Center(child: Text(t("Платежей пока нет", "No payments yet"), style: TextStyle(color: sText)))
                          : ListView.builder(
                              itemCount: debt.history.length,
                              itemBuilder: (ctx, i) {
                                var h = debt.history[i];
                                return Container(
                                  margin: const EdgeInsets.only(bottom: 12),
                                  padding: const EdgeInsets.all(16),
                                  decoration: BoxDecoration(color: globalIsLightMode ? Colors.black.withOpacity(0.05) : Colors.white.withOpacity(0.05), borderRadius: BorderRadius.circular(16)),
                                  child: Row(
                                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                    children: [
                                      Row(
                                        children: [
                                          Icon(Icons.check_circle, color: barColor, size: 20),
                                          const SizedBox(width: 12),
                                          Text('${t("Дата", "Date")}: ${formatCustomDate(DateTime.parse(h['date']))}', style: TextStyle(color: sText, fontSize: 16)),
                                        ]
                                      ),
                                      Text('+ ${formatMoney(h['amount'])} $appCurrency', style: TextStyle(color: pText, fontSize: 16, fontWeight: FontWeight.bold)),
                                    ]
                                  )
                                );
                              }
                            )
                      )
                    ]
                  )
                )
              )
            );
          }
        );
      }
    );
  }

  @override Widget build(BuildContext context) {
    return Stack(
      children: [
        Container(color: globalIsLightMode ? Colors.white : (widget.currentBg == 'black_solid' ? Colors.black : const Color(0xFF0F0F13))), 
        if (widget.currentBg != null && widget.currentBg != 'white_solid' && widget.currentBg != 'black_solid') Positioned.fill(child: Image.network(widget.currentBg!, fit: BoxFit.cover)), 
        if (globalIsBgBlurred && widget.currentBg != null && widget.currentBg != 'white_solid' && widget.currentBg != 'black_solid') Positioned.fill(child: BackdropFilter(filter: ImageFilter.blur(sigmaX: 15, sigmaY: 15), child: Container(color: Colors.transparent))), 
        if (!globalIsBgBlurred && widget.currentBg != null && widget.currentBg != 'white_solid' && widget.currentBg != 'black_solid') Positioned.fill(child: Container(color: Colors.black.withOpacity(0.5))), 
        Scaffold(
          backgroundColor: Colors.transparent, 
          appBar: AppBar(backgroundColor: Colors.transparent, elevation: 0, title: Text(t('Долги', 'Debts'), style: TextStyle(fontWeight: FontWeight.bold, color: pText)), iconTheme: IconThemeData(color: pText)), 
          floatingActionButton: FloatingActionButton(backgroundColor: appAccentColor, foregroundColor: accentTextColor, elevation: 5, onPressed: _showAddDebtSheet, child: const Icon(Icons.add)), 
          body: myDebts.isEmpty ? Center(child: Text(t("Нет активных долгов", "No active debts"), style: TextStyle(color: sText))) 
            : ListView.builder(
                padding: const EdgeInsets.all(20), itemCount: myDebts.length, 
                itemBuilder: (context, index) { 
                  final d = myDebts[index]; 
                  double pct = d.paidAmount / d.totalAmount; if(pct>1) pct=1;
                  Color barColor = d.type == 'i_owe' ? Colors.redAccent : Colors.green;
                  return Dismissible(
                    key: Key(d.id), direction: DismissDirection.endToStart, 
                    onDismissed: (_) => _deleteDebt(index), 
                    background: Container(margin: const EdgeInsets.only(bottom: 12), alignment: Alignment.centerRight, padding: const EdgeInsets.only(right: 20), decoration: BoxDecoration(color: Colors.redAccent, borderRadius: BorderRadius.circular(20)), child: const Icon(Icons.delete, color: Colors.white)), 
                    child: GlassCard(
                      margin: const EdgeInsets.only(bottom: 16), padding: const EdgeInsets.all(16), 
