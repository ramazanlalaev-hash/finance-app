class GlassCard extends StatelessWidget {
  final Widget child; final EdgeInsetsGeometry? padding, margin; final Color? customBorder; final VoidCallback? onTap;
  const GlassCard({super.key, required this.child, this.padding, this.margin, this.customBorder, this.onTap});
  
  @override 
  Widget build(BuildContext context) { 
    return GestureDetector(
      onTap: onTap, 
      child: Container(
        margin: margin, 
        child: ClipRRect(
          borderRadius: BorderRadius.circular(20), 
          child: BackdropFilter(
            filter: ImageFilter.blur(sigmaX: globalIsBgBlurred ? 15 : 0, sigmaY: globalIsBgBlurred ? 15 : 0), 
            child: Container(
              padding: padding ?? const EdgeInsets.all(20), 
              decoration: BoxDecoration(color: gBg, borderRadius: BorderRadius.circular(20), border: Border.all(color: customBorder ?? gBorder)), 
              child: child
            )
          )
        )
      )
    ); 
  }
}

class DateRangePickerButton extends StatelessWidget {
  final DateTimeRange selectedDateRange; final Function(DateTimeRange) onRangeChanged;
  const DateRangePickerButton({super.key, required this.selectedDateRange, required this.onRangeChanged});
  
  Future<void> _pickRange(BuildContext context) async {
    final DateTimeRange? picked = await showDateRangePicker(
      context: context, initialDateRange: selectedDateRange, firstDate: DateTime(2020), lastDate: DateTime(2030), 
      builder: (context, child) { 
        return Theme(
          data: globalIsLightMode 
            ? ThemeData.light().copyWith(scaffoldBackgroundColor: const Color(0xFFF5F5F7), colorScheme: ColorScheme.light(primary: appAccentColor, surface: const Color(0xFFF5F5F7), onSurface: Colors.black, onPrimary: Colors.white)) 
            : ThemeData.dark().copyWith(scaffoldBackgroundColor: const Color(0xFF15151A), colorScheme: ColorScheme.dark(primary: appAccentColor, surface: const Color(0xFF15151A), onSurface: Colors.white, onPrimary: Colors.black)), 
          child: child!
        ); 
      }
    );
    if (picked != null) onRangeChanged(picked);
  }
  
  @override 
  Widget build(BuildContext context) {
    String label = "${formatCustomDate(selectedDateRange.start)} - ${formatCustomDate(selectedDateRange.end)}";
    if (selectedDateRange.start.year == selectedDateRange.end.year && selectedDateRange.start.month == selectedDateRange.end.month && selectedDateRange.start.day == 1 && selectedDateRange.end.day == DateTime(selectedDateRange.start.year, selectedDateRange.start.month + 1, 0).day) {
      label = "${['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'][selectedDateRange.start.month - 1]} ${selectedDateRange.start.year}";
    }
    return GlassCard(
      onTap: () => _pickRange(context), 
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8), 
      child: Row(
        mainAxisSize: MainAxisSize.min, 
        children: [
          Icon(Icons.calendar_today_rounded, color: appAccentColor, size: 16), 
          const SizedBox(width: 6), 
          Flexible(child: Text(label, style: TextStyle(color: pText, fontWeight: FontWeight.bold), overflow: TextOverflow.ellipsis)), 
          const SizedBox(width: 4), 
          Icon(Icons.keyboard_arrow_down_rounded, color: sText, size: 18)
        ]
      )
    );
  }
}
