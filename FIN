  Future<void> _showAddTransactionSheet(BuildContext context) async {
    if (myAccounts.isEmpty) { 
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(t('Сначала создайте счет в Настройках', 'Create an account in Settings first')), backgroundColor: Colors.orange)); 
      return; 
