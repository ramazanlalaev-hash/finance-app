String t(String ru, String en) {
  if (appLanguage == 'ru') return ru;
  if (appLanguage == 'en') return en;
  if (appLanguage == 'kk') return kkTranslations[ru] ?? en; 
  return en;
}

String formatCustomDate(DateTime d) => '${d.day} ${['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'][d.month - 1]} ${d.year}';
String formatMoney(int amount) => amount.toString().replaceAllMapped(RegExp(r'(\d{1,3})(?=(\d{3})+(?!\d))'), (Match m) => '${m[1]} ');

