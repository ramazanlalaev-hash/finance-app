}

Future<void> loadLocalData() async { 
  myDeviceId = await secureStorage.read(key: 'device_id') ?? '';
  if (myDeviceId.isEmpty) {
    myDeviceId = 'user_${DateTime.now().millisecondsSinceEpoch}_${Random().nextInt(100000)}';
    await secureStorage.write(key: 'device_id', value: myDeviceId);
  }

  final prefs = await SharedPreferences.getInstance(); 
  
  String? savedLang = prefs.getString('app_language');
  if (savedLang == null || savedLang.isEmpty) {
    String deviceLang = ui.PlatformDispatcher.instance.locale.languageCode;
    appLanguage = ['ru', 'en', 'kk'].contains(deviceLang) ? deviceLang : 'en';
    await prefs.setString('app_language', appLanguage);
  } else {
    appLanguage = savedLang;
  }

  String? savedCur = prefs.getString('app_currency');
  if (savedCur == null || savedCur.isEmpty) {
    String? country = ui.PlatformDispatcher.instance.locale.countryCode;
    Map<String, String> defaultCurrencies = {
      'KZ': '₸', 'RU': '₽', 'BY': 'Br', 'UA': '₴', 'AZ': '₼', 'AM': '֏',
      'UZ': 'soʻm', 'KG': 'с', 'TJ': 'SM', 'GE': 'ლ',
      'US': '\$', 'GB': '£', 'FR': '€', 'DE': '€', 'ES': '€', 'IT': '€', 
      'CN': '¥', 'JP': '¥', 'CH': '₣', 'AE': 'د.إ'
    };
    appCurrency = defaultCurrencies[country] ?? '\$';
    await prefs.setString('app_currency', appCurrency);
  } else {
    appCurrency = savedCur;
  }
  
  useSingleAccount = prefs.getBool('use_single_account') ?? false;
  
  final accStr = prefs.getString('my_accounts'); 
  if (accStr != null) { try { myAccounts = List<BankAccount>.from(jsonDecode(accStr).map((x) => BankAccount.fromJson(x))); } catch(e) { myAccounts = []; } }
  if (myAccounts.isEmpty) myAccounts = [BankAccount(id: '1', name: t('Наличные', 'Cash'), balance: 0, color: Colors.green, icon: Icons.payments)];
  
  final goalStr = prefs.getString('my_goals'); 
  if (goalStr != null) { try { myGoals = List<BigGoal>.from(jsonDecode(goalStr).map((x) => BigGoal.fromJson(x))); } catch(e){} }
  
  final recStr = prefs.getString('my_recurring'); 
  if (recStr != null) { try { myRecurring = List<RecurringTx>.from(jsonDecode(recStr).map((x) => RecurringTx.fromJson(x))); } catch(e){} }
  
  final debtStr = prefs.getString('my_debts'); 
  if (debtStr != null) { try { myDebts = List<Debt>.from(jsonDecode(debtStr).map((x) => Debt.fromJson(x))); } catch(e){} }
}

