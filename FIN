  Future<void> _loadLimits() async { 
    final prefs = await SharedPreferences.getInstance(); 
    setState(() { limits = {}; for (var cat in appCategories) { int? l = prefs.getInt('limit_${cat.name}'); if (l != null) limits[cat.name] = l; } }); 
  }
  
  Future<void> _setLimit(String catName, int limitAmount) async { 
    final prefs = await SharedPreferences.getInstance(); 
    if (limitAmount <= 0) { await prefs.remove('limit_$catName'); setState(() => limits.remove(catName)); } 
    else { await prefs.setInt('limit_$catName', limitAmount); setState(() => limits[catName] = limitAmount); } 
  }

